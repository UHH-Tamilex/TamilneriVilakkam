<text corresp="#YV1916a"><body xml:lang="ta">
  <milestone unit="page" n="122" facs="149"/>
  <lg corresp="#TNV22poem14">
<l>mutukkuṟain taṉaḷē mutukkuṟain taṉaḷē</l>
<l>malaiyaṉ oḷvēṟ kaṇṇi</l>
<l>mulaiyum vārāḷ mutukkuṟain taṉaḷē</l></lg>
 <pb n="149" facs="176"/>
   <lg corresp="#TNV16poem13">
      <l>kaviyaṅ karuṇkaṭ ceyyavāyp paintoṭi</l>
<l>pūviri naṟumeṉ kūntalum</l>
<l>vēypurai tōḷu maṇaṅkumā lemmē</l>
   </lg> 
<pb n="179" facs="206"/>
   <lg corresp="#TNV17poem8">
<l>pūtta veṅkai viyaṉciṉai yēṟi</l>
<l>mayiliṉa makavu nāṭa</l>
<l>ṉaṉṉutaṟ koṭicci maṉattakat tōṉē</l>
   </lg>
  </body></text><text corresp="#YV1916b"><body xml:lang="ta">
